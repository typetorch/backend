# Keep the build context small and secret-free: the image is built from src/, basin/, web/ and the two package files.
.git
.gitattributes
.gitignore
.scratch
node_modules
web/node_modules
dist
web/dist
# the public demo (web/demo, demo.typetorch.dev): its data pack, build and deploy tool are never part of the image
web/demo
web/dist-demo
web/vite.demo.config.ts
data
.loadtest
*.log
*.tsbuildinfo
**/.env
**/.env.*
**/*.env
CHANGELOG.md
web/CHANGELOG.md
test
scripts
server
compose*.yaml
README.md
